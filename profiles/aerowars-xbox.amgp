<?xml version="1.0" encoding="UTF-8"?>
<!--
  AeroWars — AntiMicroX profil pro Xbox-kompatibilní ovladač
  Testováno s: Xbox 360, Xbox One, Xbox Series, 8BitDo (Xbox mode)

  Ovládání:
    Levá páčka    → pohled (kamera / myš)
    Pravá páčka Y → pitch letadla (dopředu = nos dolů, dozadu = nos nahoru)
    Pravá páčka X → yaw + roll (doleva / doprava)
    RT (pravý trigger) → STŘELBA
    LT (levý trigger)  → PLYN (throttle up)
    LB (levý bumper)   → BRZDA (throttle down)
    Tlačítko A         → Nastoupit / vystoupit (pravý klik)
    Tlačítko B         → KATAPULTÁŽ (Shift+S)
    Tlačítko X         → Spawn fighter (/spawn_fighter via klávesa F5)

  Jak načíst:
    1. Otevřít AntiMicroX
    2. File → Load Profile → vybrat tento soubor
    3. Profil přiřadit ke svému ovladači

  GUID níže odpovídá Xbox 360 Wireless — pro jiný ovladač použijte
  "Controller Mappings" v AntiMicroX pro nalezení správného GUID.
-->
<gamecontroller configversion="19" appversion="3.3.4">
    <sdlname>Xbox 360 Controller</sdlname>
    <guid>030000005e040000a102000000007801</guid>
    <profilename>AeroWars Flight</profilename>
    <keyPressTime>10</keyPressTime>

    <sets>
        <set index="1">

            <!-- ═══════════════════════════════════════════
                 LEVÁ PÁČKA → POHLED KAMERY (pohyb myši)
                 Osy 1 (X) + 2 (Y)
                 ═══════════════════════════════════════════ -->
            <stick index="1">
                <stickAxisAssociation stickAxesIndex="1" stickAxesIndex2="2"/>

                <!-- Nahoru → myš nahoru -->
                <stickbutton index="1">
                    <slots>
                        <slot>
                            <code>1</code>
                            <mode>mousemovement</mode>
                        </slot>
                    </slots>
                </stickbutton>

                <!-- Doprava → myš doprava -->
                <stickbutton index="2">
                    <slots>
                        <slot>
                            <code>4</code>
                            <mode>mousemovement</mode>
                        </slot>
                    </slots>
                </stickbutton>

                <!-- Dolů → myš dolů -->
                <stickbutton index="3">
                    <slots>
                        <slot>
                            <code>2</code>
                            <mode>mousemovement</mode>
                        </slot>
                    </slots>
                </stickbutton>

                <!-- Doleva → myš doleva -->
                <stickbutton index="4">
                    <slots>
                        <slot>
                            <code>3</code>
                            <mode>mousemovement</mode>
                        </slot>
                    </slots>
                </stickbutton>

                <deadZone>6000</deadZone>
                <maxZone>32767</maxZone>
                <diagonalRange>45</diagonalRange>
                <mousespeedx>20</mousespeedx>
                <mousespeedy>20</mousespeedy>
            </stick>

            <!-- ═══════════════════════════════════════════
                 PRAVÁ PÁČKA → ŘÍZENÍ LETADLA
                 Osy 4 (X) + 5 (Y) — nebo 3+4 viz poznámka
                 ═══════════════════════════════════════════ -->
            <stick index="2">
                <stickAxisAssociation stickAxesIndex="4" stickAxesIndex2="5"/>

                <!-- Pravá páčka NAHORU → nos dolů (Shift = pitch down) -->
                <stickbutton index="1">
                    <slots>
                        <slot>
                            <code>16777248</code>
                            <mode>keyboard</mode>
                        </slot>
                    </slots>
                </stickbutton>

                <!-- Pravá páčka DOPRAVA → yaw vpravo (D) + roll vpravo (RMB) -->
                <stickbutton index="2">
                    <slots>
                        <slot>
                            <code>68</code>
                            <mode>keyboard</mode>
                        </slot>
                        <slot>
                            <code>3</code>
                            <mode>mousebutton</mode>
                        </slot>
                    </slots>
                </stickbutton>

                <!-- Pravá páčka DOLŮ → nos nahoru (Space = pitch up) -->
                <stickbutton index="3">
                    <slots>
                        <slot>
                            <code>32</code>
                            <mode>keyboard</mode>
                        </slot>
                    </slots>
                </stickbutton>

                <!-- Pravá páčka DOLEVA → yaw vlevo (A) + roll vlevo (LMB) -->
                <stickbutton index="4">
                    <slots>
                        <slot>
                            <code>65</code>
                            <mode>keyboard</mode>
                        </slot>
                        <slot>
                            <code>1</code>
                            <mode>mousebutton</mode>
                        </slot>
                    </slots>
                </stickbutton>

                <deadZone>8000</deadZone>
                <maxZone>32767</maxZone>
                <diagonalRange>45</diagonalRange>
            </stick>

            <!-- ═══════════════════════════════════════════
                 TRIGGERY
                 ═══════════════════════════════════════════ -->

            <!-- Levý trigger (LT) → W (throttle up / plyn) -->
            <trigger index="1">
                <slots>
                    <slot>
                        <code>87</code>
                        <mode>keyboard</mode>
                    </slot>
                </slots>
                <deadZone>2000</deadZone>
                <maxZone>32767</maxZone>
            </trigger>

            <!-- Pravý trigger (RT) → E (střelba / aux1) -->
            <trigger index="2">
                <slots>
                    <slot>
                        <code>69</code>
                        <mode>keyboard</mode>
                    </slot>
                </slots>
                <deadZone>2000</deadZone>
                <maxZone>32767</maxZone>
            </trigger>

            <!-- ═══════════════════════════════════════════
                 BUMPERY
                 ═══════════════════════════════════════════ -->

            <!-- LB (levý bumper, index 5) → S (throttle down / brzda) -->
            <button index="5">
                <slots>
                    <slot>
                        <code>83</code>
                        <mode>keyboard</mode>
                    </slot>
                </slots>
            </button>

            <!-- RB (pravý bumper, index 6) → volné / rezerva -->
            <!-- <button index="6"> ... </button> -->

            <!-- ═══════════════════════════════════════════
                 TLAČÍTKA
                 ═══════════════════════════════════════════ -->

            <!-- Tlačítko A (index 1) → pravý klik (nastoupit / vystoupit) -->
            <button index="1">
                <slots>
                    <slot>
                        <code>3</code>
                        <mode>mousebutton</mode>
                    </slot>
                </slots>
            </button>

            <!-- Tlačítko B (index 2) → Shift + S (katapultáž) -->
            <button index="2">
                <slots>
                    <slot>
                        <code>16777248</code>
                        <mode>keyboard</mode>
                    </slot>
                    <slot>
                        <code>83</code>
                        <mode>keyboard</mode>
                    </slot>
                </slots>
            </button>

            <!-- Tlačítko X (index 3) → F1 (lze přepsat na chat příkaz) -->
            <button index="3">
                <slots>
                    <slot>
                        <code>16777264</code>
                        <mode>keyboard</mode>
                    </slot>
                </slots>
            </button>

            <!-- Tlačítko Y (index 4) → Tab (inventář) -->
            <button index="4">
                <slots>
                    <slot>
                        <code>16777217</code>
                        <mode>keyboard</mode>
                    </slot>
                </slots>
            </button>

        </set>
    </sets>
</gamecontroller>
